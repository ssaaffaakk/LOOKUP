WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# N2YO — ISS and satellite visual passes (optional)
# Free tier: https://www.n2yo.com/api/
N2YO_API_KEY=

# The following APIs require NO key (already working):
