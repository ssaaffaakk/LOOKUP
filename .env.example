# IBM watsonx.ai — required for AI-powered identification
# Get your API key from https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# OpenWeatherMap — real-time cloud cover, temperature, humidity
# Free tier: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# N2YO — ISS and satellite visual passes
# Free tier: https://www.n2yo.com/api/
N2YO_API_KEY=

# TNS (Transient Name Server) — real supernova/nova alerts
# Register at https://www.wis-tns.org/
TNS_API_KEY=
